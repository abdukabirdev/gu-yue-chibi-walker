{
  "manifest_version": 3,
  "name": "Chibi Walker",
  "version": "9.2",
  "description": "Твой чиби-маскот живёт на всех сайтах: гуляет, прыгает по элементам страницы, летает, когда его бросают, читает сайт и (по желанию) отвечает через Gemini.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications",
    "webNavigation"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Чиби-маскот",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "errhook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "poses/*/*.webp",
        "poses/*/skin.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}